{
  "name": "blender-ogc3dtiles-docs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "description": "Fumadocs site of the add-on: user guide and features in content/docs, developer notes synced from ../docs/*.md at build time.",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "build": "node scripts/sync-content.mjs && next build",
    "dev": "node scripts/sync-content.mjs && next dev -p 3210",
    "start": "npx serve out -l 3210",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "beautiful-mermaid": "1.1.3",
    "fumadocs-core": "16.15.12",
    "fumadocs-mdx": "15.4.2",
    "fumadocs-ui": "16.15.12",
    "lucide-react": "^0.548.0",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-raw": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
