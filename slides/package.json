{
  "name": "blender-ogc3dtiles-slides",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "node ../scripts/docs-media.mjs pull screenshots && node scripts/dev.mjs",
    "build": "open-slide build",
    "preview": "open-slide preview",
    "sync:skills": "open-slide sync:skills",
    "static": "node ../scripts/docs-media.mjs pull screenshots && node scripts/publish.mjs --serve",
    "pdf": "node ../scripts/docs-media.mjs pull screenshots --strict && node scripts/publish.mjs --pdf",
    "shots": "node scripts/title-shots.mjs"
  },
  "dependencies": {
    "@open-slide/core": "^2.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.63.0",
    "vite": "8.3.6"
  }
}
