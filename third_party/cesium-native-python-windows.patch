diff --git a/cmake/Dependencies.cmake b/cmake/Dependencies.cmake
index 6ff5553..14665d1 100644
--- a/cmake/Dependencies.cmake
+++ b/cmake/Dependencies.cmake
@@ -9,6 +9,24 @@ if(NOT EXISTS "${CESIUM_NATIVE_DIR}/CMakeLists.txt")
     message(FATAL_ERROR "Missing submodule: extern/cesium-native. Run: git submodule update --init --recursive")
 endif()
 
+message(STATUS "Adding cesium-native subdirectory...")
+add_subdirectory(extern/cesium-native EXCLUDE_FROM_ALL)
+
+# --- Windows fix: libzip needs zlib, which only exists once ezvcpkg (run by the
+# cesium-native subdirectory above) has installed it. Build libzip afterwards and
+# point FindZLIB at the vcpkg prefix.
+if(WIN32 AND NOT ZLIB_ROOT)
+    set(_ez_base "$ENV{EZVCPKG_BASEDIR}")
+    if(NOT _ez_base)
+        set(_ez_base "$ENV{USERPROFILE}/.ezvcpkg")
+    endif()
+    file(TO_CMAKE_PATH "${_ez_base}/501db0f17ef6df184fcdbfbe0f87cde2313b6ab1/installed/x64-windows-static-md" _ez_inst)
+    if(EXISTS "${_ez_inst}/include/zlib.h")
+        set(ZLIB_ROOT "${_ez_inst}")
+        set(ZLIB_USE_STATIC_LIBS ON)
+        message(STATUS "libzip: using vcpkg zlib at ${_ez_inst}")
+    endif()
+endif()
 set(LIBZIP_DIR "${CMAKE_SOURCE_DIR}/extern/libzip")
 if(NOT EXISTS "${LIBZIP_DIR}/CMakeLists.txt")
     message(FATAL_ERROR "Missing submodule: extern/libzip. Run: git submodule update --init --recursive")
@@ -29,8 +47,6 @@ set(ENABLE_LZMA OFF CACHE BOOL "Disable lzma support")
 set(ENABLE_ZSTD OFF CACHE BOOL "Disable zstd support")
 add_subdirectory(extern/libzip EXCLUDE_FROM_ALL)
 
